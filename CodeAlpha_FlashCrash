from flask import Flask, render_template, redirect, url_for, request, flash
from flask_sqlalchemy import SQLAlchemy
from flask_login import LoginManager, UserMixin, login_user, login_required, logout_user, current_user
from werkzeug.security import generate_password_hash, check_password_hash
from PyPDF2 import PdfReader

app = Flask(__name__)
app.config['SECRET_KEY'] = 'flashcrash_secret'
app.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///flashcrash.db'
db = SQLAlchemy(app)

login_manager = LoginManager()
login_manager.init_app(app)
login_manager.login_view = "login"

# User model
class User(UserMixin, db.Model):
    id = db.Column(db.Integer, primary_key=True)
    gmail = db.Column(db.String(150), unique=True, nullable=False)
    password = db.Column(db.String(150), nullable=False)

# Flashcard model
class Flashcard(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    question = db.Column(db.String(500))
    answer = db.Column(db.String(500))
    options = db.Column(db.String(500))  # comma-separated
    user_id = db.Column(db.Integer, db.ForeignKey('user.id'))

@login_manager.user_loader
def load_user(user_id):
    return User.query.get(int(user_id))

@app.route("/")
@login_required
def home():
    cards = Flashcard.query.filter_by(user_id=current_user.id).all()
    return render_template("dashboard.html", cards=cards)

@app.route("/signup", methods=["GET","POST"])
def signup():
    if request.method == "POST":
        gmail = request.form.get("gmail")
        password = request.form.get("password")
        hashed_pw = generate_password_hash(password, method="sha256")
        new_user = User(gmail=gmail, password=hashed_pw)
        db.session.add(new_user)
        db.session.commit()
        login_user(new_user)  # auto-login after signup
        return redirect(url_for("home"))
    return render_template("signup.html")

@app.route("/login", methods=["GET","POST"])
def login():
    if request.method == "POST":
        gmail = request.form.get("gmail")
        password = request.form.get("password")
        user = User.query.filter_by(gmail=gmail).first()
        if user and check_password_hash(user.password, password):
            login_user(user)
            return redirect(url_for("home"))
        flash("Invalid credentials")
    return render_template("login.html")

@app.route("/logout")
@login_required
def logout():
    logout_user()
    return redirect(url_for("login"))

@app.route("/upload_pdf", methods=["POST"])
@login_required
def upload_pdf():
    file = request.files["pdf"]
    if file:
        reader = PdfReader(file)
        for page in reader.pages:
            text = page.extract_text()
            if text:
                lines = text.split("\n")
                question = lines[0]
                answer = " ".join(lines[1:])
                # Generate four options (last one is correct)
                options = f"A) Wrong1,B) Wrong2,C) Wrong3,D) {answer}"
                new_card = Flashcard(question=question, answer=answer, options=options, user_id=current_user.id)
                db.session.add(new_card)
        db.session.commit()
    return redirect(url_for("home"))

@app.route("/add", methods=["POST"])
@login_required
def add_card():
    q = request.form.get("question")
    a = request.form.get("answer")
    opts = request.form.get("options")
    new_card = Flashcard(question=q, answer=a, options=opts, user_id=current_user.id)
    db.session.add(new_card)
    db.session.commit()
    return redirect(url_for("home"))

@app.route("/edit/<int:id>", methods=["POST"])
@login_required
def edit_card(id):
    card = Flashcard.query.get(id)
    if card and card.user_id == current_user.id:
        card.question = request.form.get("question")
        card.answer = request.form.get("answer")
        card.options = request.form.get("options")
        db.session.commit()
    return redirect(url_for("home"))

@app.route("/delete/<int:id>")
@login_required
def delete_card(id):
    card = Flashcard.query.get(id)
    if card and card.user_id == current_user.id:
        db.session.delete(card)
        db.session.commit()
    return redirect(url_for("home"))

if __name__ == "__main__":
    db.create_all()
    app.run(debug=True)
